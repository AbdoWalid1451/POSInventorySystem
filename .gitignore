## ===========================================================
## .gitignore for a C# WinForms + ADO.NET solution (Visual Studio)
## ===========================================================

## --- Build output ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Dd]ebugPublic/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

## --- Visual Studio user files ---
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.rsuser

## --- Visual Studio Code ---
.vscode/

## --- JetBrains Rider ---
.idea/
*.sln.iml

## --- ReSharper ---
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

## --- Build results / cache ---
*.pdb
*.cache
*.log
*.tmp
*.tmp_proj
*.vspscc
*.vssscc
*.pidb
*.svclog
*.scc
*_i.c
*_p.c
*.ilk
*.meta
*.obj
*.iobj
*.ipdb
*.pch
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.vspscc
*.psess
*.vsp
*.vspx

## --- NuGet ---
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

## --- Test results & coverage ---
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
TestResults/

## --- Publish output ---
publish/
PublishScripts/
*.publish.xml
*.pubxml
*.azurePubxml

## --- Crystal Reports / Report Viewer temp (if used) ---
*.rdl.data
*.rdlc.data

## --- Local database files (keep SQL scripts, ignore data files) ---
*.mdf
*.ldf
*.ndf
*.bak
*.bacpac
*.sdf
*.db
*.sqlite
*.sqlite3
App_Data/*.mdf
App_Data/*.ldf

## --- Secrets & local settings (never commit passwords) ---
appsettings.Development.json
appsettings.Local.json
secrets.json
*.secret
*.pfx
*.snk
.env
.env.*
## If your connection string contains a password, ignore the real config
## and commit an example file instead:
## App.config
## !App.config.example

## --- Generated files ---
*.Designer.cs.bak
*.orig
*.rej

## --- OS files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

## --- Uploaded / generated runtime data (product images, exports, receipts) ---
Uploads/
Exports/
Backups/
